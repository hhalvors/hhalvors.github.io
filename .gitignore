# Symlink to ~/bibliotek/Brøchner, Hans — points outside the repo, not committed.
# To set up locally: ln -s "/Users/hhalvors/bibliotek/Brøchner, Hans" brochner
/brochner/
# Symlink to ~/bibliotek/Nielsen, Rasmus — points outside the repo, not committed.
# To set up locally: ln -s "/Users/hhalvors/bibliotek/Nielsen, Rasmus" nielsen
/nielsen/
# Symlink to ~/bibliotek/Høffding, Harald — points outside the repo, not committed.
# To set up locally: ln -s "/Users/hhalvors/bibliotek/Høffding, Harald" hoeffding
/hoeffding/
# Slide image directories (build-time dependencies, rendered outputs embed them)
docs/talks/*-img/
talks/*-img/

# Illustrations used to build slides and lecture notes: book jackets, author
# portraits, archival scans. Not my work, so they are not mine to redistribute
# in a public repository. The rendered PDF/HTML embeds them and is published;
# the source images stay on my disk.
talks/**/*.jpg
talks/**/*.jpeg
talks/**/*.png
talks/**/*.gif
talks/**/*.wmf
talks/**/*.emf
talks/**/*.tif
talks/**/*.tiff
talks/**/*.zip
courses/**/*.jpg
courses/**/*.jpeg
courses/**/*.png
courses/**/*.gif
courses/**/*.wmf
courses/**/*.emf
# Exceptions: images that published course pages actually reference, and that
# are either my own or archival scans forming the substance of the page rather
# than decoration. Keep this list short — if it grows, the rule above is wrong.
!courses/phi367_s2026/img/*
!courses/phi538_f2024/qr-code.jpeg

# Archival map scans from Det Kongelige Bibliotek; nothing references them.
kierkegaard-copenhagen/
# Screenshots of my own pages, used while designing. Not content.
previews/

# CV build artifacts (generated from data/talks-master.yaml by the site build)
/.cvbuild/
/cv-talks.tex
/cv-outreach.tex

