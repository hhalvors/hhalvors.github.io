# Slide image directories (build-time dependencies, rendered outputs embed them)
docs/talks/*-img/
talks/*-img/

# CV build artifacts (generated from data/talks-master.yaml by the site build)
/.cvbuild/
/cv-talks.tex
/cv-outreach.tex

# Emacs backup files
*~

# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
*.bbl
*.bcf
*.blg
*.run.xml
*.fls
*.fdb_latexmk
# Beamer and minted leave these behind too
*.nav
*.snm
*.toc
*.vrb
*.minted
_minted/
_minted-*/

# Haskell build output
dist-newstyle/
*.hi
*.o
# Compiled executable of the standalone lemmon-filter project (57 MB).
# The module the site actually builds against is src/filters/lemmonFilter.hs.
lemmon-filter/src/lemmonFilter

# Emacs auto-save (#file#) and lock files; *~ backups are covered above
\#*\#
.\#*

# macOS, and the stubs a FUSE mount leaves when a file is deleted while open
.DS_Store
.fuse_hidden*

# Ad-hoc backups
*.backup

